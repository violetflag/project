%% Planspace v0.1.0 기준 (app-flowchart 스킬로 그림)
flowchart TD
  subgraph engine["AI 엔진 고르기"]
    step["AI 표시가 붙은 단계마다<br/>lib/actions.ts의 withAi"]
    keyq{"API 키가<br/>이 브라우저에 있나?"}
    claude[("Anthropic API<br/>claude-opus-5-5")]
    fail{"호출이<br/>성공했나?"}
    local["로컬 생성기<br/>lib/generator.ts의 정해진 템플릿"]
    result["결과를 채팅과 문서에 반영"]
    step --> keyq
    keyq -->|"있음"| claude --> fail
    keyq -->|"없음"| local
    fail -->|"성공"| result
    fail -. "키 오류·연결 끊김" .-> local
    local --> result
  end

  subgraph start["시작"]
    home["홈 화면<br/>아이디어를 적고 보내기"]
    create["프로젝트 만들기<br/>createProject: 이 브라우저에 저장"]
  end

  subgraph ask["질문 받기"]
    qmake["AI 질문 6개 만들기<br/>아이디어에 맞춘 객관식"]
    answer["질문에 답하기<br/>선택지 고르기 또는 직접 입력"]
    summary["AI 답변 요약<br/>다음 할 일 버튼 표시"]
    more["질문 더 받고<br/>더 정확하게 만들기"]
  end

  subgraph plan["기획서 만들기"]
    prdbtn["바로 PRD 만들기"]
    planmake["AI PRD와 기능명세서 작성<br/>다섯 섹션 + 기능 묶음"]
    docs["PRD · 기능명세서 탭<br/>직접 고치기, 기능 추가·삭제"]
  end

  subgraph improve["다듬기"]
    chat["채팅으로 요청<br/>예: 리뷰 기능 추가해줘"]
    chatai["AI 요청 해석<br/>추가·수정·검토 중 무엇인지 판단"]
    reviewrun["AI 기획 검토<br/>개발·사업·UX·QA·보안·운영"]
    choices["AI 해결 방법 3개<br/>하나를 고르면 수정안 생성"]
    pending["AI 수정안<br/>승인해야 기능명세서에 반영"]
  end

  subgraph draw["그림 만들기"]
    flow["유저플로우 탭<br/>기능 묶음을 줄로 나눠 그림"]
    wire["와이어프레임 탭<br/>기능별 화면 뼈대"]
  end

  subgraph keep["공유"]
    share["공유 → 내보내기<br/>Markdown · CSV · JSON"]
  end

  result ~~~ home
  home --> create --> qmake --> answer
  answer -->|"다 답하면"| summary
  summary -. "더 묻고 싶을 때" .-> more
  more --> answer
  summary --> prdbtn --> planmake --> docs
  docs --> chat --> chatai
  chatai -->|"기능 추가·수정"| pending
  chatai -->|"검토해줘"| reviewrun
  docs -->|"기획서 전체 검토하기"| reviewrun
  reviewrun --> choices --> pending
  pending -->|"✓ 승인"| docs
  docs --> flow
  docs --> wire
  docs --> share
