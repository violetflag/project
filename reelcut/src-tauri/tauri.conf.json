{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelcut",
  "version": "2.19.4",
  "identifier": "com.reelcut.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reelcut",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "bin/ffprobe.exe": "bin/ffprobe.exe",
      "bin/whisper/": "bin/whisper/"
    },
    "fileAssociations": [
      { "ext": ["osv", "lrf"], "name": "DJI Osmo 360 Video", "description": "DJI Osmo 360 Video", "role": "Viewer" },
      { "ext": ["reelcut"], "name": "Reelcut 프로젝트", "description": "Reelcut 프로젝트", "role": "Editor" },
      { "ext": ["reelcutpack"], "name": "Reelcut 프로젝트 묶음", "description": "Reelcut 프로젝트 묶음", "role": "Editor" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
